{
  "name": "GameVault",
  "version": "1.2.5",
  "type": "module",
  "description": "An open and extensible multi-store game launcher for Steam Deck. Access Epic, GOG, Amazon, and itch.io games directly from Game Mode.",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "watch": "rollup -c -w",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Starkka15/junkstore.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "Epic",
    "GOG",
    "Amazon",
    "Itchio",
    "steam-deck",
    "deck"
  ],
  "author": "Starkka15",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/Starkka15/junkstore/issues"
  },
  "homepage": "https://github.com/Starkka15/junkstore#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/plugin-replace": "^5.0.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/webpack": "^5.28.0",
    "rollup": "^4.53.3",
    "shx": "^0.3.4",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "mobx": "^6.12.1",
    "react-icons": "^5.0.1",
    "react-qr-code": "^2.0.12"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
